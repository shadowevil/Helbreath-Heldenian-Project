{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python -I -S \"C:/Users/ShadowEvil/source/Helbreath-Heldenian-Project/.claude/hooks/doc_size_guard.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python -I -S \"C:/Users/ShadowEvil/source/Helbreath-Heldenian-Project/.claude/hooks/archive_guard.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
