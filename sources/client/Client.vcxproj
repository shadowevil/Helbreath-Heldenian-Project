  <ImportGroup Label="ExtensionTargets">
  </ImportGroup>
  <!-- Build ID: written into this project's untracked build folder before every compile, rewritten only
       when the value changes so an unchanged source state does not recompile. -->
  <Target Name="GenerateBuildId" BeforeTargets="ClCompile">
    <Exec Command="&quot;$(HbPython)&quot; &quot;$(HbSourcesDir)build_tools\gen_build_id.py&quot; --environment $(HbEnvironment) --configuration $(Configuration) --output &quot;$(HbGeneratedDir)build_id_generated.h&quot;$(HbFreshSourceSwitch)$(HbCleanVerifiedSwitch)" />
  </Target>
  <!-- Release seed: one file shared with the server. Writes a seed only when none exists, so a lone build
       reuses the current one; only build_release.ps1 rolls a new seed. Debug never reads it. -->
  <Target Name="EnsureReleaseSeed" BeforeTargets="ClCompile" Condition="'$(Configuration)'!='Debug'">
    <Exec Command="&quot;$(HbPython)&quot; &quot;$(HbSourcesDir)build_tools\gen_release_seed.py&quot; --mode ensure --environment $(HbEnvironment) --configuration $(Configuration) --output &quot;$(HbReleaseSeedDir)release_seed_generated.h&quot;" />
  </Target>
  <!-- VERSIONINFO fragment from the release in version.h; game.rc includes it once phase B switches over. -->
  <Target Name="GenerateVersionInfo" BeforeTargets="ResourceCompile">
    <Exec Command="&quot;$(HbPython)&quot; &quot;$(HbSourcesDir)build_tools\gen_version_info.py&quot; --component $(HbVersionComponent) --description &quot;$(HbVersionDescription)&quot; --original-filename $(TargetName)$(TargetExt) --internal-name $(TargetName) --configuration $(Configuration) --output &quot;$(HbGeneratedDir)version_info.rc&quot;" />
  </Target>
</Project>