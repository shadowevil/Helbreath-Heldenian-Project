  <!-- Versioning (sources/build_tools, shared/version.h). HbEnvironment is DEV unless a build overrides it;
       TEST and PROD also need /p:Configuration=Release and HbFreshSourceSwitch set to the generator's
       fresh-source flag (see gen_build_id.py; an XML comment cannot hold its double hyphen). -->
  <PropertyGroup>
    <HbEnvironment Condition="'$(HbEnvironment)'==''">DEV</HbEnvironment>
    <HbFreshSourceSwitch Condition="'$(HbFreshSourceSwitch)'==''"></HbFreshSourceSwitch>
    <!-- build.ps1 / build_release.ps1 set this after checking the whole tree once, before the build
         writes anything; a bare MSBuild run leaves it empty and the generator checks itself. -->
    <HbCleanVerifiedSwitch Condition="'$(HbCleanVerifiedSwitch)'==''"></HbCleanVerifiedSwitch>
    <!-- The Build ID comes from git state, which MSBuild cannot see as an input: without this the IDE's
         fast up-to-date check would skip the generator and run a binary with a stale Build ID. -->
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
    <HbVersionComponent>server</HbVersionComponent>
    <HbVersionDescription>Helbreath server</HbVersionDescription>
    <!-- One folder per configuration AND channel, so a DEV header can never feed a TEST build -->
    <HbGeneratedDir>$(HbIntDir)$(HbEnvironment.ToLower())\generated\</HbGeneratedDir>
    <!-- build.ps1 passes the interpreter it found; an IDE build uses python from PATH -->
    <HbPython Condition="'$(HbPython)'==''">python</HbPython>
    <!-- One seed per channel, shared by the client and the server of that channel -->
    <HbReleaseSeedDir>$(HbBuildRoot)generated\$(HbEnvironment.ToLower())\</HbReleaseSeedDir>
  </PropertyGroup>
